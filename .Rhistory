# ---- 2. Query function with confirmed-working pagination ---------------
get_all_interactions <- function(taxon, page_size = 10000) {
skip <- 0
pages <- list()
repeat {
page <- tryCatch({
if (PAGINATION_METHOD == "opts") {
get_interactions_by_taxa(sourcetaxon = taxon, opts = list(limit = page_size, skip = skip))
} else if (PAGINATION_METHOD == "otherkeys") {
get_interactions_by_taxa(sourcetaxon = taxon, otherkeys = list(limit = page_size, skip = skip))
} else {
# no working pagination found - single bare call, may be capped
# at GloBI's default limit for very well-documented genera
get_interactions_by_taxa(sourcetaxon = taxon)
}
}, error = function(e) {
message("  ! error for '", taxon, "': ", conditionMessage(e))
NULL
})
if (is.null(page) || nrow(page) == 0) break
pages[[length(pages) + 1]] <- page
if (PAGINATION_METHOD == "none" || nrow(page) < page_size) break
skip <- skip + page_size
}
if (length(pages) == 0) return(NULL)
dplyr::bind_rows(pages)
}
