error = function(e) {
message("  ! error for '", taxon, "': ", conditionMessage(e))
NULL
}
)
if (is.null(page) || nrow(page) == 0) break
pages[[length(pages) + 1]] <- page
if (nrow(page) < page_size) break  # last page reached
skip <- skip + page_size
}
if (length(pages) == 0) return(NULL)
dplyr::bind_rows(pages)
}
# ---------------------------------------------------------------------------
# 4. Loop through unique taxa, collecting interactions
# ---------------------------------------------------------------------------
all_results <- list()
for (taxon in unique_taxa) {
message("Querying: ", taxon)
res <- get_all_interactions(taxon)
if (!is.null(res) && nrow(res) > 0) {
res$queried_taxon <- taxon   # keep track of which input name produced this
all_results[[taxon]] <- res
}
Sys.sleep(0.2)  # small delay to be polite to the GloBI API
}
all_results_fixed <- lapply(all_results, function(df) {
df %>% mutate(across(everything(), as.character))
})
totalInteractions <- dplyr::bind_rows(all_results_fixed)
# ---------------------------------------------------------------------------
# 5. Summarise: how many of your unique taxa show up as a source_taxon_name
#    in what GloBI returned
# ---------------------------------------------------------------------------
source_names_in_globi <- unique(totalInteractions$source_taxon_name)
matched_taxa   <- unique_taxa[unique_taxa %in% source_names_in_globi]
unmatched_taxa <- unique_taxa[!unique_taxa %in% source_names_in_globi]
matched_taxa_returned   <- names(all_results_fixed)
unmatched_taxa_returned <- setdiff(unique_taxa, matched_taxa_returned)
matched_taxa_returned
unmatched_taxa_returned
matched_taxa
matched_taxa_returned
